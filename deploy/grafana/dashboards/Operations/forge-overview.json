{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "expr": "(changes(max(forge_deployment_timestamp_seconds)[1m:]) > 0) * on() group_left(revision) topk(1, forge_deployment_timestamp_seconds)",
        "hide": false,
        "iconColor": "blue",
        "name": "Deploy revision",
        "tagKeys": "revision",
        "titleFormat": "{{revision}} {{reason}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "expr": "(changes(forge_maintenance_mode[1m]) != 0) * on(instance, job) group_left(reason, revision) forge_maintenance_info",
        "hide": false,
        "iconColor": "blue",
        "name": "Maintenance",
        "tagKeys": "reason revision",
        "titleFormat": "{{revision}} {{reason}}"
      }
    ]
  },
