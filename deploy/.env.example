# ==============================================================================
# COMPOSE / REVISION
# COMPOSE_PROJECT_NAME bestimmt das Praefix aller Container-Namen.
# SOURCE_REVISION setzt deploy.sh aus dem Git-Stand, wenn hier "unknown" steht.
# ==============================================================================
COMPOSE_PROJECT_NAME=forge
IMAGE_TAG=latest
SOURCE_REVISION=unknown


# ==============================================================================
# DEPLOYMENT-INFRASTRUKTUR (serverindividuell)
# DATA_ROOT: Basis fuer alle persistenten Daten (Bind-Mounts, siehe README).
# DEPLOY_GROUP: Unix-Gruppe, die .env und secrets/*.txt lesen darf (0640).
#   Die GID wird zur Laufzeit aufgeloest; kein DEPLOY_GROUP_GID hier eintragen.
# ==============================================================================
DATA_ROOT=/srv/forge/data
DEPLOY_GROUP=forge-deploy


# ==============================================================================
# BACKUP & WIEDERHERSTELLUNG
# BACKUP_SHARE: zweiter Ablageort (NAS/USB), Ziel des rsync nach jedem Backup.
# RESTORE_BACKUP: Backup-Verzeichnis fuer das Profil restore-verification.
# ==============================================================================
BACKUP_SHARE=/srv/forge/backup-share
RESTORE_BACKUP=/srv/forge/backup-share/REPLACE_WITH_BACKUP


# ==============================================================================
# TIMEOUTS / WARTUNGSFENSTER (Sekunden, 60 bis 172800)
# ==============================================================================
DEPLOY_MAINTENANCE_TIMEOUT_SECONDS=3600
RESTORE_MAINTENANCE_TIMEOUT_SECONDS=7200
# Preflight verlangt mindestens so viel freien Platz auf DATA_ROOT und BACKUP_SHARE.
MIN_FREE_GB=5


# ==============================================================================
# TLS / ZERTIFIKATE
# Zertifikat muss APP_DOMAIN, MONITORING_DOMAIN und ADMIN_DOMAIN abdecken (SAN).
# ==============================================================================
TLS_CERT_FILE=/etc/forge/tls/fullchain.pem
TLS_KEY_FILE=/etc/forge/tls/privkey.pem


# ==============================================================================
# DOMAINS & PORTS
# Drei verschiedene Hostnamen: App, Grafana (Monitoring), pgAdmin (Admin).
# APP_HOST_ALIASES wird an ALLOWED_HOSTS angehaengt (fuer lokale curl-Checks).
# CSRF_TRUSTED_ORIGINS nur anpassen, wenn HTTPS_PORT nicht 443 ist
# (z. B. https://forge.example.local:8443).
# ==============================================================================
APP_DOMAIN=forge.example.local
MONITORING_DOMAIN=monitoring.forge.example.local
ADMIN_DOMAIN=db.forge.example.local
APP_HOST_ALIASES=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://forge.example.local
HTTP_PORT=80
HTTPS_PORT=443


# ==============================================================================
# DATENBANK – POSTGRESQL & PGBOUNCER
# Passwort liegt als Docker Secret in secrets/postgres_password.txt.
# POSTGRES_CONN_MAX_AGE=0 ist Pflicht hinter pgBouncer (Transaction-Pooling).
# ==============================================================================
POSTGRES_DB=forge
POSTGRES_USER=forge
POSTGRES_CONN_MAX_AGE=0
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=5


# ==============================================================================
# SKALIERUNG / REPLIKATE
# ==============================================================================
WEB_REPLICAS=2
CELERY_REPLICAS=1
# Anzahl paralleler Tasks pro Celery-Worker
CELERY_CONCURRENCY=2


# ==============================================================================
# NETZWERK / PROXY
# Leer lassen, wenn kein ausgehender Proxy noetig ist.
# ==============================================================================
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,nginx,web,postgres,pgbouncer,redis,meilisearch,grafana,loki,prometheus,pgadmin,alloy,node-exporter,pgbouncer-exporter,blackbox-exporter,pushgateway


# ==============================================================================
# OBSERVABILITY – METRIKEN, LOGS & DASHBOARDS (Profil observability)
# ==============================================================================
PUSHGATEWAY_URL=http://pushgateway:9091
# Login-Adresse fuer pgAdmin (Profil administration); Passwort in secrets/pgadmin_password.txt
PGADMIN_DEFAULT_EMAIL=admin@forge.example.local
PROMETHEUS_RETENTION=45d
PROMETHEUS_RETENTION_SIZE=10GB
ALERTMANAGER_RETENTION=120h
LOKI_RETENTION=168h
# Basis-URL fuer Runbook-Links in Alert-Benachrichtigungen
OBSERVABILITY_RUNBOOK_BASE_URL=https://github.com/EliasBauer/Forge/blob/main/deploy/runbooks


# ==============================================================================
# ALERTING (Microsoft Teams optional, E-Mail via SMTP)
# ALERT_TEAMS_ENABLED=false: secrets/teams_workflow_url.txt darf leer sein.
# ALERT_SMTP_AUTH_ENABLED=false: ALERT_SMTP_PASSWORD_FILE=/dev/null lassen.
# ==============================================================================
ALERT_TEAMS_ENABLED=false
ALERT_SMTP_SMARTHOST=smtp.example.local:25
ALERT_SMTP_FROM=forge-alerts@example.local
ALERT_SMTP_AUTH_ENABLED=false
ALERT_SMTP_REQUIRE_TLS=false
ALERT_SMTP_PASSWORD_FILE=/dev/null
ALERT_SMTP_USERNAME=
ALERT_EMAIL_TO=forge-ops@example.local
