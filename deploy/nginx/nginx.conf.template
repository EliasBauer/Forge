log_format safe '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

map "$maintenance_mode:$status:$uri" $serve_maintenance {
    volatile;
    default 0;
    ~^1:[^:]*:/nginx-healthz$ 0;
    ~^1:503:/maintenance\.html$ 0;
    ~^1:[^:]*:/logo\.svg$ 0;
    ~^1: 1;
}

resolver 127.0.0.11 valid=10s ipv6=off;

upstream forge_web {
    zone forge_web 64k;
    server web:8000;
}

server {
    listen 80;
    server_name ${APP_DOMAIN} ${MONITORING_DOMAIN} ${ADMIN_DOMAIN};

    access_log /dev/stdout safe;
    error_log /dev/stderr warn;

    return 308 https://$host$request_uri;
}

server {
    listen 80 default_server;
    server_name _;

    access_log /dev/stdout safe;
    error_log /dev/stderr warn;

    location / {
        return 404;
    }
}

server {
    listen 8080;
    server_name _;

    access_log off;

    location = /nginx_status {
        stub_status;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${APP_DOMAIN};
    root /usr/share/nginx/html;

    ssl_certificate ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /dev/stdout safe;
    error_log /dev/stderr warn;
    client_max_body_size 20m;

    set $maintenance_mode 0;
    if (-f /run/forge/maintenance) {
        set $maintenance_mode 1;
    }
    if ($serve_maintenance) {
        return 503;
    }

    error_page 503 /maintenance.html;

    location = /nginx-healthz {
        access_log off;
        return 200 "ok\n";
    }

    location = /maintenance.html {
        internal;
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store" always;
    }

    location = /logo.svg {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store" always;
    }

    location /static/ {
        alias /static/;
    }

    location ~ ^/(graphql|api|admin|health)(/|$) {
        proxy_pass http://forge_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${MONITORING_DOMAIN};

    ssl_certificate ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /dev/stdout safe;
    error_log /dev/stderr warn;

    location / {
        set $grafana_backend http://grafana:3000;
        proxy_pass $grafana_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_DOMAIN};

    ssl_certificate ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /dev/stdout safe;
    error_log /dev/stderr warn;

    auth_basic "Forge administration";
    auth_basic_user_file ${ADMIN_HTPASSWD_FILE};

    location / {
        set $pgadmin_backend http://pgadmin:5050;
        proxy_pass $pgadmin_backend;

        proxy_set_header Host ${ADMIN_DOMAIN};
        proxy_set_header X-Forwarded-Host ${ADMIN_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
